# مثال على ملف البيئة - انسخ هذا الملف إلى .env وقم بتعديل القيم

# إعدادات الخادم
API_BASE_URL=http://localhost:8000/api
API_TIMEOUT=30

# إعدادات قاعدة البيانات (للخادم)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medical_app
DB_USER=medical_user
DB_PASSWORD=your_password

# إعدادات الأمان
JWT_SECRET=your_jwt_secret_key
ENCRYPTION_KEY=your_encryption_key

# إعدادات الملفات
UPLOAD_PATH=/uploads
MAX_FILE_SIZE=10MB
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif

# إعدادات البريد الإلكتروني
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@medicalapp.com
FROM_NAME=Medical App

# إعدادات الإشعارات
ENABLE_PUSH_NOTIFICATIONS=true
FCM_SERVER_KEY=your_fcm_server_key

# إعدادات التطبيق
APP_NAME=Medical Consultation App
APP_VERSION=1.0.0
DEBUG_MODE=true
LOG_LEVEL=debug

# إعدادات الأمان الإضافية
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=15

# إعدادات التخزين السحابي (اختياري)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=your_bucket_name
AWS_REGION=us-east-1

# إعدادات التحليلات (اختياري)
GOOGLE_ANALYTICS_ID=your_ga_id
FIREBASE_PROJECT_ID=your_firebase_project_id